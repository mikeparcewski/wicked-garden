{
  "spec": 2,
  "name": "garden-mcp-inspector",
  "vendor": "garden",
  "version": "0.1.0",
  "description": "MCP inspector: an artifact editor plugin for wicked-studio.",
  "editors": [
    {
      "id": "garden-mcp-inspector",
      "title": "MCP inspector",
      "version": "0.1.0",
      "protocol": [
        1,
        2
      ],
      "kinds": [
        "mcp-server"
      ],
      "entry": "editors/garden-mcp-inspector/index.html",
      "sha256": "6797c576c79c77a02c435c6cd257d69680eb6653d5a6202ee5bf9498b87c96e0",
      "sizes": [
        "inline",
        "pane",
        "full"
      ],
      "surfaces": {
        "card": {
          "interactive": true,
          "aspect": "auto",
          "actions": [
            {
              "id": "refresh",
              "label": "List again",
              "verb": "plugin"
            }
          ]
        },
        "options": {
          "tabs": [
            {
              "id": "resources",
              "label": "Resources",
              "render": "plugin"
            },
            {
              "id": "prompts",
              "label": "Prompts",
              "render": "plugin"
            },
            {
              "id": "log",
              "label": "Log",
              "render": "plugin"
            }
          ]
        },
        "full": {
          "modes": [
            "simple",
            "advanced"
          ],
          "default": "simple"
        }
      },
      "permissions": [
        {
          "id": "artifact.read",
          "why": "to read the artifact it opens"
        },
        {
          "id": "mcp.session",
          "why": "to start and talk to the MCP servers you connect it to"
        },
        {
          "id": "ui.fullscreen",
          "why": "to go full screen"
        }
      ]
    }
  ]
}
