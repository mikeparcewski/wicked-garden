        "WICKED_KNOWLEDGE_DB",
        "WICKED_XEDGE_DB",
        "WICKED_ESTATE_READONLY",
        "WICKED_GOVERNED",
        "WICKED_RUN_ID",
        "WICKED_RUN_UNIT",
        "WICKED_RUN_AGENT",
        "WICKED_RUN_PROJECT",
        "WICKED_GATE_SCOPE",
        "WICKED_WRITE_ROOTS"
      ]
