{
  "name": "wicked-garden",
  "version": "12.62.0",
  "type": "module",
  "description": "The skills your coding agent can't build alone: a proof gate that re-checks \"done\" from evidence, graph-aware search and cross-file renames (with wicked-estate), 40 QE specialists, and review panels with labelled fallbacks. Works in Claude Code, Codex, Antigravity, OpenCode and Pi, in CI, or in a wicked-crew job.",
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "evidence-gate",
    "code-graph",
    "code-intelligence",
    "refactoring",
    "testing",
    "memory",
    "multi-model",
    "agentic",
    "wicked-qe",
    "wicked-bus"
  ],
  "author": {
    "name": "Mike Parcewski"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeparcewski/wicked-garden.git"
  },
  "homepage": "https://github.com/mikeparcewski/wicked-garden",
  "bugs": "https://github.com/mikeparcewski/wicked-garden/issues",
  "bin": {
    "wicked-garden": "install.mjs"
  },
  "main": "install.mjs",
  "scripts": {
    "test": "node scripts/ci/run_pytest.js",
    "version": "node .github/scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json .claude-plugin/marketplace.json .codex-plugin/plugin.json",
    "prepublishOnly": "node install.mjs --version"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
