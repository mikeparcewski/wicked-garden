{
  "version": 1,
  "derivedFrom": [
    ".github/workflows/ci.yml",
    "pyproject.toml"
  ],
  "checks": [
    {
      "name": "test",
      "cwd": ".",
      "stage": [
        "creator",
        "verify"
      ],
      "run": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "-p",
        "no:cacheprovider",
        "-o",
        "junit_family=xunit1"
      ],
      "failedExit": [
        1
      ],
      "results": {
        "kind": "junit",
        "id": [
          "file",
          "name"
        ],
        "idJoin": "::",
        "how": {
          "argvAppend": [
            "--junitxml=.wicked-floor/junit.xml"
          ],
          "env": {},
          "path": ".wicked-floor/junit.xml"
        }
      },
      "list": {
        "run": [
          "python3",
          "-m",
          "pytest",
          "--collect-only",
          "-q",
          "-p",
          "no:cacheprovider"
        ],
        "item": "^(?P<id>\\S+\\.py::.+)$"
      },
      "alone": {
        "run": [
          "python3",
          "-m",
          "pytest",
          "-q",
          "-p",
          "no:cacheprovider",
          "-o",
          "junit_family=xunit1",
          "{id}"
        ]
      },
      "deselect": {
        "append": [
          "--deselect={id}"
        ]
      },
      "invalidatedBy": [
        "pyproject.toml",
        "setup.cfg",
        "tox.ini",
        "pytest.ini",
        "**/conftest.py",
        ".github/workflows/**"
      ],
      "probes": {
        "mutation": {
          "file": "tests/test_wicked_mutation.py",
          "content": "def test_wicked_mutation_probe():\n    assert 1 + 1 == 3, \"deliberately failing: the build-guide mutation probe\"\n",
          "expectId": "tests/test_wicked_mutation.py::test_wicked_mutation_probe"
        },
        "mutation2": {
          "file": "tests/test_wicked_mutation_two.py",
          "content": "def test_wicked_mutation_two_probe():\n    assert 1 + 1 == 3, \"deliberately failing: the build-guide second mutation probe\"\n",
          "expectId": "tests/test_wicked_mutation_two.py::test_wicked_mutation_two_probe"
        }
      }
    }
  ]
}
