#!/bin/sh
# wicked-garden launcher — POSIX twin of scripts/wicked-garden.mjs (the implementation).
# wicked-crew prepends <snapshot>/scripts to a seat's PATH so `wicked-garden run …` in
# skill text resolves here; it needs `node` (>= 18) on PATH and nothing else (no coreutils).
# Never edit the logic here — it lives once, in wicked-garden.mjs.
case $0 in
  */*) dir=${0%/*} ;;
  *)   dir=. ;;
esac
exec node "$dir/wicked-garden.mjs" "$@"
