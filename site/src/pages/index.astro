---
/**
 * index.astro — wicked-garden (wg.wickedagile.com), the CAPABILITY deep-dive.
 *
 * Wave-2 rebuild. Garden is the capability plane of the wicked platform — THE
 * catalog agents act through: the toolkit for what a coding agent can't do
 * alone, starting with a proof gate that re-derives "done" from evidence. The retired
 * wicked-testing site's story (the wall, the 40-specialist fleet) now lives // historical
 * here as the qe domain bands (#qe / #fleet) — wt.wickedagile.com redirects
 * to #qe. Chrome (Base/Topbar/Footer/SameGarden + plane tokens) comes from
 * wicked-web pinned at 61396e4 (the four-plane platform story).
 */
import Base from "wicked-web/layouts/Base.astro";
import Topbar from "wicked-web/components/Topbar.astro";
import Footer from "wicked-web/components/Footer.astro";
import SameGarden from "wicked-web/components/SameGarden.astro";
import "../styles/global.css";
import "../styles/site.css";
import { G } from "../data/garden";
import CopyChip from "../components/react/CopyChip.tsx";
import HeroStamp from "../components/react/HeroStamp.tsx";
import Toolbox from "../components/react/Toolbox.tsx";
import ProveGate from "../components/react/ProveGate.tsx";
import CapabilityGrid from "../components/react/CapabilityGrid.tsx";
import QeWall from "../components/react/QeWall.tsx";
import QeFleet from "../components/react/QeFleet.tsx";
import ExtendPack from "../components/react/ExtendPack.tsx";
import InstallBench from "../components/react/InstallBench.tsx";

const favicon = `${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/{2,}/g, "/");

// Three benefits, right under the hero (released).
const BENEFITS = [
  {
    h: "Proof, not claims.",
    p: "Run the proof gate and “done” is re-checked from evidence: an unsupported claim is rejected, and by default the gate fails closed if its checks cannot run (an explicit claim-only fallback is labelled).",
    tail: { pre: " Which entry paths block and which only advise is ", link: "spelled out", href: "https://github.com/mikeparcewski/wicked-garden#what-blocks-what-advises", post: "." },
  },
  {
    h: "Sees what grep can’t, with wicked-estate.",
    p: "On estate’s code graph it finds the event and command links grep never sees, for blast radius, and its patch skill renames across files as a graph operation.",
  },
  {
    h: "40 QE specialists and a second opinion.",
    p: "Its acceptance pipeline keeps the writer, the executor and the reviewer apart. When a decision is disputed, a review panel weighs in using the other agents you have installed; a same-family fallback is labelled, and without a quorum it gives no verdict.",
  },
];

// What's new in 12.62, one line each.
// Each: a bold lead, an optional command (code), then the rest; spaces live in the strings, so
// compressHTML can never fuse a word to the next inline tag.
const NEW = [
  { b: "In a wicked-crew job, every agent is asked to propose what it witnessed,", rest: " as a memory for you to approve, with its source recorded." },
  { b: "Domain mapping keeps going page after page until real requirements reach the target,", rest: " and asks before it spends more." },
  { b: "Style learning:", code: "repo-learn", rest: " learns how you or your team works from a showcase repo or your writing (studio’s Learn shows the results as suggestions to accept or drop)." },
];
---

<Base
  title="wicked-garden — the skills your coding agent can't build alone"
  description={`wicked-garden is the skill catalog of the wicked platform: the skills your coding agent can't build alone. A proof gate re-checks "done" from evidence instead of taking the agent's word; graph-aware search and refactors see links grep can't; 40 QE specialists test the work; a review panel of your other agents, with a labelled same-family fallback, weighs in on disputed decisions; estate-backed memory where agents suggest and you approve. ${G.skills} skills across ${G.domains} domains, and an open naming contract to ship your own skill pack. Local-first, MIT.`}
  bodyClass="has-grain"
  favicon={favicon}
>
  <Topbar pkg="wicked-garden" repo="https://github.com/mikeparcewski/wicked-garden" />
  <main>

    <!-- ── HERO ─────────────────────────────────────────────────────────── -->
    <section id="hero" class="gd-section gd-hero">
      <div class="mx-auto w-full max-w-[1240px] px-5 sm:px-8">
        <div class="gd-hero-grid">
          <div class="gd-hero-pitch">
            <p class="rise kicker" style="animation-delay:.05s">
              the skill catalog · works in your agent, CI or a crew job · MIT
            </p>
            <h1 class="gd-hero-h1">
              <span class="rise block" style="animation-delay:.12s">The tools your coding agent</span>
              <span class="rise block gd-hero-h1-2" style="animation-delay:.2s">can’t build alone.</span>
            </h1>
            <p class="rise gd-hero-sub" style="animation-delay:.3s">
              Skills for Claude Code, Codex, Antigravity, OpenCode and Pi; also in CI, or inside a
              wicked-crew job. The first one matters most:{" "}
              <span class="gd-hero-em">a proof gate that re-derives “done” from evidence instead of taking the agent’s word.</span>
            </p>
            <div class="rise gd-hero-install" style="animation-delay:.42s">
              <p class="gd-hero-install-label">load out garden and its peers — one command</p>
              <CopyChip client:load text="npx wicked-installer" label="copy" />
              <p class="gd-hero-install-note">interactive · picks your products across CLIs · direct install below</p>
            </div>
            <ul class="rise gd-hero-stats" style="animation-delay:.5s">
              <li><b>{G.skills}</b> skills</li>
              <li><b>{G.domains}</b> domains</li>
              <li><b>40</b> QE specialists</li>
              <li><b>10</b> work-shapes</li>
              <li><b>MIT</b> · local-first</li>
            </ul>
          </div>
          <div class="gd-hero-demo">
            <HeroStamp client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- ── WHY (three benefits) + WHAT'S NEW IN 12.62 ───────────────────── -->
    <section id="why" class="gd-section gd-band" aria-labelledby="why-h">
      <div class="mx-auto w-full max-w-[1240px] px-5 sm:px-8">
        <h2 id="why-h" class="wy-sr">What garden does for you</h2>
        <ul class="wy-cards" role="list">
          {BENEFITS.map((b) => (
            <li class="wy-card">
              <h3 class="wy-h">{b.h}</h3>
              <p class="wy-p">{b.p}{b.tail && <>{b.tail.pre}<a href={b.tail.href}>{b.tail.link}</a>{b.tail.post}</>}</p>
            </li>
          ))}
        </ul>
        <h2 class="wy-new-h" id="new-h">What’s new in 12.62</h2>
        <ul class="wy-new" role="list" aria-labelledby="new-h">
          {NEW.map((n) => <li><b>{n.b}</b>{n.code && <>{" "}<code>{n.code}</code></>}{n.rest}</li>)}
        </ul>
      </div>
    </section>

    <!-- ── THE TOOLBOX (own tools) ──────────────────────────────────────── -->
    <section id="toolbox" class="gd-section gd-band">
      <Toolbox client:load />
    </section>

    <!-- ── THE GATE (the differentiator, drivable) ──────────────────────── -->
    <section id="gate" class="gd-section">
      <ProveGate client:load />
    </section>

    <!-- ── THE GRID (full capability surface + bundled family) ──────────── -->
    <section id="toolkit" class="gd-section gd-band">
      <CapabilityGrid client:load />
    </section>

    <!-- ── THE QE WALL (absorbed from the retired wicked-testing site) ──── --><!-- historical -->
    <section id="qe" class="gd-section">
      <QeWall client:load />
    </section>

    <!-- ── THE QE FLEET (40 specialists, tabbed by surface) ─────────────── -->
    <section id="fleet" class="gd-section gd-band">
      <QeFleet client:load />
    </section>

    <!-- ── BUILD ON IT (the extension pitch) ────────────────────────────── -->
    <section id="extend" class="gd-section">
      <ExtendPack client:load />
    </section>

    <!-- ── THE BENCH (install) ──────────────────────────────────────────── -->
    <section id="install" class="gd-section gd-band">
      <InstallBench client:load />
    </section>

    <!-- ── THE PLATFORM MAP (shared chrome — you are here: capability) ──── -->
    <section id="platform-map" class="gd-map-section">
      <SameGarden current="wicked-garden" />
    </section>

  </main>
  <Footer repo="https://github.com/mikeparcewski/wicked-garden" />
</Base>

<style>
  /* #why: three benefits and what's new, in the page's card language (scoped to this page). */
  .wy-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .wy-cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; }
  .wy-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.1rem 1.15rem 1.2rem; border: 1px solid var(--hairline-strong); border-radius: 14px; background: color-mix(in oklab, var(--canvas-2) 88%, transparent); }
  .wy-h { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; line-height: 1.2; color: var(--ink); }
  .wy-p { margin: 0; font-size: 0.92rem; line-height: 1.55; color: var(--muted); }
  .wy-p a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .wy-new-h { margin: clamp(1.2rem, 3vh, 2rem) 0 0.6rem; font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; color: var(--ink); }
  .wy-new { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; }
  .wy-new li { font-size: 0.88rem; line-height: 1.5; color: var(--muted); padding-left: 0.9rem; border-left: 2px solid var(--hairline-strong); }
  .wy-new b { color: var(--ink); font-weight: 600; }
  .wy-new code { font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink); }
  @media (max-width: 1023px) { .wy-cards, .wy-new { grid-template-columns: 1fr; } }
</style>
