---
/**
 * index.astro — wicked-garden (wg.wickedagile.com), the CAPABILITY deep-dive.
 *
 * v2: one claim followed through ten frames. The hero's agent claims "build: all
 * acceptance tests pass"; each section shows another way garden checks it (the gate
 * re-derives it, the graph shows what it touches, the QE wall has someone else judge
 * it, the panel settles a dispute, memory records the decision for you to approve),
 * then the catalog, the extension contract and the install. Every section is one
 * frame that snaps (src/scripts/snap-guard.ts locks it only while every frame fits)
 * and every demo reserves its tallest state. The qe bands (#qe / #fleet) carry the
 * retired wicked-testing site's story; wt.wickedagile.com redirects to #qe. // historical
 * Chrome (Base/Topbar/Footer/SameGarden + tokens) comes from wicked-web.
 */
import Base from "wicked-web/layouts/Base.astro";
import Topbar from "wicked-web/components/Topbar.astro";
import Footer from "wicked-web/components/Footer.astro";
import SameGarden from "wicked-web/components/SameGarden.astro";
import "../styles/global.css";
import "../styles/site.css";
import { G } from "../data/garden";
import CopyChip from "../components/react/CopyChip.tsx";
import HeroStamp from "../components/react/HeroStamp.tsx";
import ProveGate from "../components/react/ProveGate.tsx";
import GraphStage from "../components/react/GraphStage.tsx";
import QeWall from "../components/react/QeWall.tsx";
import QeFleet from "../components/react/QeFleet.tsx";
import PanelVote from "../components/react/PanelVote.tsx";
import MemoryQueue from "../components/react/MemoryQueue.tsx";
import CatalogExplorer from "../components/react/CatalogExplorer.tsx";
import ExtendPack from "../components/react/ExtendPack.tsx";
import InstallBench from "../components/react/InstallBench.tsx";

// The story spine: the token in the left gutter follows the hero's first claim down the page.
// Each step names how that section checks it (illustrative labels, like the demos).
const STORY = [
  { s: "hero", t: "claimed by the agent" },
  { s: "gate", t: "re-derived" },
  { s: "graph", t: "3 files touched" },
  { s: "qe", t: "reviewed cold" },
  { s: "panel", t: "panel 2 of 3" },
  { s: "memory", t: "memory proposed" },
];
---

<Base
  title="wicked-garden — the tools your coding agent can't build alone"
  description={`wicked-garden is the skill catalog of the wicked platform: the tools your coding agent can't build alone. A proof gate re-checks "done" from evidence instead of taking the agent's word; graph-aware search and refactors see links grep can't; 40 QE specialists test the work; a review panel of your other agents, with a labelled same-family fallback, weighs in on disputed decisions; estate-backed memory where agents suggest and you approve. ${G.skills} skills across ${G.domains} domains, and an open naming contract to ship your own skill pack. Local-first, MIT.`}
  bodyClass="has-grain"
>
  <Topbar pkg="wicked-garden" repo="https://github.com/mikeparcewski/wicked-garden" />
  <main>
    <div class="st-token" aria-hidden="true" data-step="hero">
      <span class="st-k">one claim, followed</span>
      <code class="st-claim">build: all acceptance tests pass</code>
      <span class="st-status">
        {STORY.map((x) => <span class="st-line" data-s={x.s}>{x.t}</span>)}
      </span>
      <ol class="st-dots">
        {STORY.map((x) => <li data-s={x.s} />)}
      </ol>
    </div>

    <!-- ── HERO ─────────────────────────────────────────────────────────── -->
    <section id="hero" class="gd-section gd-hero" data-token="hero">
      <div class="sx-wrap gd-hero-grid">
        <div class="gd-hero-pitch">
          <p class="rise kicker gd-kicker" style="animation-delay:.05s">
            the skill catalog · works in your agent, CI or a crew job · MIT
          </p>
          <h1 class="gd-hero-h1">
            <span class="rise block" style="animation-delay:.12s">The tools your coding agent</span>
            <span class="rise block gd-hero-h1-2" style="animation-delay:.2s">can’t build alone.</span>
          </h1>
          <p class="rise gd-hero-sub" style="animation-delay:.3s">
            Skills for Claude Code, Codex, Antigravity, OpenCode and Pi; also in CI, or inside a
            wicked-crew job. The first one matters most:{" "}
            <span class="gd-hero-em">a proof gate that re-derives “done” from evidence instead of taking the agent’s word.</span>
          </p>
        </div>
        <div class="gd-hero-demo rise" style="animation-delay:.36s">
          <HeroStamp client:load />
        </div>
        <div class="gd-hero-get rise" style="animation-delay:.42s">
          <div class="gd-hero-install">
            <p class="gd-hero-install-label">load out garden and its peers — one command</p>
            <CopyChip client:load text="npx wicked-installer" label="copy" />
            <p class="gd-hero-install-note">interactive · picks your products across CLIs · direct install below</p>
          </div>
          <ul class="gd-hero-stats">
            <li><b>{G.skills}</b> skills</li>
            <li><b>{G.domains}</b> domains</li>
            <li><b>{G.qeSpecialists}</b> QE specialists</li>
            <li><b>{G.workShapes}</b> work-shapes</li>
            <li><b>MIT</b> · local-first</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ── THE GATE (the first one matters most: drivable) ──────────────── -->
    <section id="gate" class="gd-section gd-band" data-token="gate">
      <ProveGate client:load />
    </section>

    <!-- ── THE GRAPH (search + patch on wicked-estate) ──────────────────── -->
    <section id="graph" class="gd-section" data-token="graph">
      <GraphStage client:load />
    </section>

    <!-- ── THE QE WALL ───────────────────────────────────────────────────── -->
    <section id="qe" class="gd-section gd-band" data-token="qe">
      <QeWall client:load />
    </section>

    <!-- ── THE QE FLEET (40 specialists by surface) ──────────────────────── -->
    <section id="fleet" class="gd-section" data-token="qe">
      <QeFleet client:load />
    </section>

    <!-- ── A SECOND OPINION (the review panel) ───────────────────────────── -->
    <section id="panel" class="gd-section gd-band" data-token="panel">
      <PanelVote client:load />
    </section>

    <!-- ── MEMORY YOU APPROVE (+ what's new) ─────────────────────────────── -->
    <section id="memory" class="gd-section" data-token="memory">
      <MemoryQueue client:load />
    </section>

    <!-- ── THE CATALOG EXPLORER (14 domains) ─────────────────────────────── -->
    <section id="toolkit" class="gd-section gd-band" data-token="off">
      <CatalogExplorer client:load />
    </section>

    <!-- ── BUILD ON IT (the extension pitch) ────────────────────────────── -->
    <section id="extend" class="gd-section" data-token="off">
      <ExtendPack client:load />
    </section>

    <!-- ── THE BENCH (install) ──────────────────────────────────────────── -->
    <section id="install" class="gd-section gd-band" data-token="off">
      <InstallBench client:load />
    </section>

    <!-- ── THE PLATFORM MAP (shared chrome — you are here: capability) ──── -->
    <section id="platform-map" class="gd-map-section" data-token="off">
      <SameGarden current="wicked-garden" />
    </section>

  </main>
  <Footer repo="https://github.com/mikeparcewski/wicked-garden" />
</Base>

<script>
  import "../scripts/snap-guard.ts";
  import "../scripts/story-token.ts";
</script>
