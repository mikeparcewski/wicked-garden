{
  "version": 1,
  "derivedFrom": [
    ".github/workflows/ci.yml",
    "pyproject.toml"
  ],
  "checks": [
    {
      "name": "test",
      "cwd": ".",
      "stage": [
        "creator",
        "verify"
      ],
      "run": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "-p",
        "no:cacheprovider",
        "-rfE"
      ],
      "failedExit": [
        1
      ],
      "results": {
        "kind": "text",
        "how": {
          "argvAppend": [
            "--force-short-summary"
          ],
          "env": {}
        }
      },
      "parser": {
        "blocks": [
          {
            "start": "^=+ short test summary info =+$",
            "item": "^(?:FAILED|ERROR) (?P<id>.+?)(?: - .*)?$",
            "end": "^(?:=+ )?[0-9]+ (?:failed|passed|errors?|skipped|deselected|xfailed|xpassed|warnings?)\\b.* in [0-9.]+s.*$",
            "use": "last-before-end"
          }
        ]
      },
      "list": {
        "run": [
          "python3",
          "-m",
          "pytest",
          "--collect-only",
          "-q",
          "-p",
          "no:cacheprovider"
        ],
        "item": "^(?P<id>\\S+\\.py::.+)$"
      },
      "alone": {
        "run": [
          "python3",
          "-m",
          "pytest",
          "-q",
          "-p",
          "no:cacheprovider",
          "-rfE",
          "{id}"
        ]
      },
      "deselect": {
        "append": [
          "--deselect={id}"
        ]
      },
      "invalidatedBy": [
        "pyproject.toml",
        "setup.cfg",
        "tox.ini",
        "pytest.ini",
        "**/conftest.py",
        ".github/workflows/**"
      ],
      "probes": {
        "mutation": {
          "file": "tests/test_wicked_mutation.py",
          "content": "def test_wicked_mutation_probe():\n    assert 1 + 1 == 3, \"deliberately failing: the build-guide mutation probe\"\n",
          "expectId": "tests/test_wicked_mutation.py::test_wicked_mutation_probe"
        }
      }
    }
  ]
}
