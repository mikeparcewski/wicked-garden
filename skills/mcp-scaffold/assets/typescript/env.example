# The ONE secret this server reads. The auth scheme in mcp-server.config.json says what it is:
# the bearer token, the API key, the basic-auth password, or the OAuth2 client secret.
# Set it in the environment of whatever launches the server; never commit a value.
__SERVER_ENV___TOKEN=

# Optional overrides (non-secret; the committed defaults live in mcp-server.config.json).
# Transport: stdio or httpStream.
# MCP_TRANSPORT=
# httpStream host (default 127.0.0.1).
# MCP_HOST=
# httpStream port (default 8080).
# MCP_PORT=
# The upstream API base URL.
# __SERVER_ENV___BASE_URL=
# httpStream only: the bearer clients must present to this server.
# MCP_SERVER_BEARER=
# Telemetry leaves the process only when an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=
